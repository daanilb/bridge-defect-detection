hlQkh1VAU1l5N590QAI1/VKR_codebrim/runs/yolov8n_img640_seed0_quick2/weights/best.pt...\n","Ultralytics 8.4.193 🚀 Python-3.13.16 torch-2.11.0+cu130 CUDA:0 (Tesla T4, 14913MiB)\n","Model summary (fused): 73 layers, 3,133,679 parameters, 0 gradients, 8.6 GFLOPs\n","\u001b[K                 Class     Images  Instances      Box(P          R      mAP50  mAP50-95): 100% ━━━━━━━━━━━━ 8/8 1.5it/s 5.3s\n","                   all        238       1290      0.214      0.222      0.143     0.0555\n","                 crack         91        350        0.1     0.0686     0.0355     0.0131\n","            spallation         79        295      0.267      0.468      0.299      0.129\n","         efflorescence         48        123       0.24     0.0566     0.0345     0.0112\n","          exposed_bars         66        254      0.206      0.429      0.233     0.0844\n","       corrosion_stain         91        268      0.256     0.0858      0.114     0.0401\n","Speed: 1.6ms preprocess, 11.9ms inference, 0.0ms loss, 3.1ms postprocess per image\n","Results saved to \u001b[1m/content/drive/.shortcut-targets-by-id/1yLmTpd6duw7lhlQkh1VAU1l5N590QAI1/VKR_codebrim/runs/yolov8n_img640_seed0_quick2\u001b[0m\n","Обучение завершено. Лучшие веса: /content/drive/.shortcut-targets-by-id/1yLmTpd6duw7lhlQkh1VAU1l5N590QAI1/VKR_codebrim/runs/yolov8n_img640_seed0_quick2/weights/best.pt\n"]}],"source":["from ultralytics import YOLO\n","\n","model = YOLO(MODEL_NAME)\n","model.train(\n","    data=str(data_yaml),\n","    epochs=EPOCHS,\n","    imgsz=IMG_SIZE,\n","    batch=BATCH,\n","    seed=SEED,\n","    deterministic=True,\n","    patience=30,\n","    project=str(RUNS_DIR),\n","    name=RUN_NAME,\n","    exist_ok=True,\n","    plots=True,\n",")\n","RUN_DIR = Path(model.trainer.save_dir)\n","BEST_WEIGHTS = RUN_DIR / 'weights' / 'best.pt'\n","print('Обучение завершено. Лучшие веса:', BEST_WEIGHTS)"]},{"cell_type":"markdown","metadata":{"id":"WF_NPp-UGFMt"},"source":["## Шаг 14. Оценка на тестовой выборке\n","\n","- **Precision** — доля найденных рамок, которые верны (меньше ложных срабатываний — выше precision).\n","- **Recall** — доля реальных повреждений, которые найдены.\n","- **F1** — гармоническое среднее precision и recall.\n","- **mAP@0.5** — средняя по классам точность при IoU ≥ 0,5; **mAP@0.5:0.95** — то же при строгих порогах IoU.\n","- **Время** — мс на одно фото.\n","\n","Результат дописывается строкой в `results/summary.csv`; метрики по классам — в `results/per_class_<запуск>.csv`."]},{"cell_type":"code","execution_count":16,"metadata":{"tags":["needs_gpu"],"colab":{"base_uri":"https://localhost:8080/"},"id":"24_SPgWiGFMt","executionInfo":{"status":"ok","timestamp":1793368994955,"user_tz":-240,"elapsed":9252,"user":{"displayName":"DanilB sniu","userId":"15957076433567930351"}},"outputId":"1851ef74-3a71-4820-b8b6-29937c39a9a4"},"outputs":[{"output_type":"stream","name":"stdout","text":["Ultralytics 8.4.193 🚀 Python-3.13.16 torch-2.11.0+cu130 CUDA:0 (Tesla T4, 14913MiB)\n","Model summary (fused): 73 layers, 3,133,679 parameters, 0 gradients, 8.6 GFLOPs\n","\u001b[34m\u001b[1mval: \u001b[0mFast image access ✅ (ping: 0.0±0.0 ms, read: 3411.7±812.3 MB/s, size: 444.1 KB)\n","\u001b[K\u001b[34m\u001b[1mval: \u001b[0mScanning /content/datasets/codebrim_yolo/labels/test... 239 images, 85 backgrounds, 0 corrupt: 100% ━━━━━━━━━━━━ 239/239 2.3Kit/s 0.1s\n","\u001b[34m\u001b[1mval: \u001b[0mNew cache created: /content/datasets/codebrim_yolo/labels/test.cache\n","\u001b[K                 Class     Images  Instances      Box(P          R      mAP50  mAP50-95): 100% ━━━━━━━━━━━━ 15/15 2.9it/s 5.1s\n","                   all        239       1300       0.18      0.192      0.125     0.0454\n","                 crack        103        442      0.115      0.077     0.0432     0.0136\n","            spallation         89        291      0.253      0.344      0.207     0.0788\n","         efflorescence         48        126      0.067     0.0159     0.0209    0.00545\n","          exposed_bars         67        207      0.228      0.435      0.242     0.0891\n","       corrosion_stain         84        234      0.236     0.0897      0.112     0.0398\n","Speed: 1.8ms preprocess, 6.5ms inference, 0.0ms loss, 3.8ms postprocess per image\n","Results saved to \u001b[1m/content/drive/.shortcut-targets-by-id/1yLmTpd6duw7lhlQkh1VAU1l5N590QAI1/VKR_codebrim/runs/yolov8n_img640_seed0_quick2_test\u001b[0m\n","=== Итог на TEST ===\n","           run: yolov8n_img640_seed0_quick2\n","         model: yolov8n\n","         imgsz: 640\n","          seed: 0\n","        epochs: 3\n","     precision: 0.1797\n","        recall: 0.1922\n","            F1: 0.1857\n","         mAP50: 0.1252\n","      mAP50_95: 0.0454\n","  inference_ms: 6.48\n","      total_ms: 12.1\n","          date: 2026-10-30 14:03\n","             класс  precision  recall   AP50  AP50_95\n","0            crack      0.115   0.077  0.043    0.014\n","1       spallation      0.253   0.344  0.207    0.079\n","2    efflorescence      0.067   0.016  0.021    0.005\n","3     exposed_bars      0.228   0.435  0.242    0.089\n","4  corrosion_stain      0.236   0.090  0.112    0.040\n"]}],"source":["import datetime\n","\n","best_model = YOLO(str(BEST_WEIGHTS))\n","m = best_model.val(data=str(data_yaml), split='test', imgsz=IMG_SIZE, batch=BATCH,\n","                   project=str(RUNS_DIR), name=RUN_NAME + '_test', exist_ok=True, plots=True)\n","\n","P, R = float(m.box.mp), float(m.box.mr)\n","F1 = 2 * P * R / (P + R + 1e-9)\n","row = {\n","    'run': RUN_NAME, 'model': Path(MODEL_NAME).stem, 'imgsz': IMG_SIZE, 'seed': SEED, 'epochs': EPOCHS,\n","    'precision': round(P, 4), 'recall': round(R, 4), 'F1': round(F1, 4),\n","    'mAP50': round(float(m.box.map50), 4), 'mAP50_95': round(float(m.box.map), 4),\n","    'inference_ms': round(m.speed['inference'], 2), 'total_ms': round(sum(m.speed.values()), 2),\n","    'date': datetime.datetime.now().strftime('%Y-%m-%d %H:%M'),\n","}\n","summary_path = RES_DIR / 'summary.csv'\n","summary = pd.concat([pd.read_csv(summary_path), pd.DataFrame([row])]) if summary_path.exists() else pd.DataFrame([row])\n","summary = summary.drop_duplicates(subset='run', keep='last')\n","summary.to_csv(summary_path, index=False)\n","\n","per_class = pd.DataFrame({\n","    'класс': [m.names[int(i)] for i in m.box.ap_class_index],\n","    'precision': np.round(m.box.p, 3), 'recall': np.round(m.box.r, 3),\n","    'AP50': np.round(m.box.ap50, 3), 'AP50_95': np.round(m.box.ap, 3),\n","})\n","per_class.to_csv(RES_DIR / f'per_class_{RUN_NAME}.csv', index=False, encoding='utf-8-sig')\n","\n","print('=== Итог на TEST ===')\n","for k, v in row.items():\n","    print(f'{k:>14}: {v}')\n","display(per_class) if 'display' in globals() else print(per_class)"]},{"cell_type":"markdown","metadata":{"id":"lptWyQgJGFMt"},"source":["## Шаг 15. Графики обучения и ошибок\n","\n","- `results.png` — потери и метрики по эпохам (если val loss растёт, а train падает — переобучение);\n","- `confusion_matrix_normalized.png` — какие классы путаются между собой и с фоном;\n","- `PR_curve.png` / `BoxPR_curve.png` — кривые precision–recall;\n","- `F1_curve.png` / `BoxF1_curve.png` — F1 в зависимости от порога уверенности (понадобится для каскада)."]},{"cell_type":"code","execution_count":17,"metadata":{"tags":["needs_gpu"],"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"ezPlWC5BGFMt","executionInfo":{"status":"ok","timestamp":1793369000853,"user_tz":-240,"elapsed":854,"user":{"displayName":"DanilB sniu","userId":"15957076433567930351"}},"outputId":"ffebe2bc-929a-45f5-fc12-c7b3d185fba9"},"outputs":[{"output_type":"stream","name":"stdout","text":["results.png\n"]},{"output_type":"display_data","data":{"image/png":"\n","text/plain":["<IPython.core.display.Image object>"]},"metadata":{"image/png":{"width":800}}},{"output_type":"stream","name":"stdout","text":["confusion_matrix_normalized.png\n"]},{"output_type":"display_data","data":{"image/png":"\n","text/plain":["<IPython.core.display.Image object>"]},"metadata":{"image/png":{"width":800}}},{"output_type":"stream","name":"stdout","text":["BoxPR_curve.png\n"]},{"output_type":"display_data","data":{"image/png":"\n","text/plain":["<IPython.core.display.Image object>"]},"metadata":{"image/png":{"width":800}}},{"output_type":"stream","name":"stdout","text":["BoxF1_curve.png\n"]},{"output_type":"display_data","data":{"image/png":"\n","text/plain":["<IPython.core.display.Image object>"]},"metadata":{"image/png":{"width":800}}}],"source":["from IPython.display import Image as IPImage, display\n","\n","TEST_DIR = RUNS_DIR / (RUN_NAME + '_test')\n","for path in [RUN_DIR / 'results.png', TEST_DIR / 'confusion_matrix_normalized.png',\n","             TEST_DIR / 'PR_curve.png', TEST_DIR / 'BoxPR_curve.png',\n","             TEST_DIR / 'F1_curve.png', TEST_DIR / 'BoxF1_curve.png']:\n","    if path.exists():\n","        print(path.name); display(IPImage(filename=str(path), width=800))"]},{"cell_type":"markdown","metadata":{"id":"Fa6bnvnzGFMt"},"source":["## Шаг 16. Предсказания модели на тестовых фото\n","\n","По одному фото каждого класса и два фото без дефектов: видно пропуски, лишние рамки и путаницу классов."]},{"cell_type":"code","execution_count":18,"metadata":{"tags":["needs_gpu"],"colab":{"base_uri":"https://localhost:8080/","height":269},"id":"xzzoOY-oGFMt","executionInfo":{"status":"ok","timestamp":1793369020728,"user_tz":-240,"elapsed":7223,"user":{"displayName":"DanilB sniu","userId":"15957076433567930351"}},"outputId":"cea8fc69-8293-4ff2-f594-bf107317b75a"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 2000x800 with 8 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["test_stems = [s for s, sp in split_of.items() if sp == 'test']\n","picked = []\n","for c in DEFECTS:\n","    cand = [s for s in defect_boxes.loc[defect_boxes[c] == 1, 'stem'].unique() if s in test_stems and s not in picked]\n","    picked += cand[:1]\n","picked += [s for s in test_stems if s not in imgs_with_defects][:2]\n","\n","preds = best_model.predict([str(DATA_DIR / 'images' / 'test' / f'{s}.jpg') for s in picked],\n","                           imgsz=IMG_SIZE, conf=0.25, verbose=False)\n","cols = 4\n","rows_n = int(np.ceil(len(preds) / cols))\n","fig, axes = plt.subplots(rows_n, cols, figsize=(5 * cols, 4 * rows_n))\n","for ax, p, s in zip(np.atleast_1d(axes).flat, preds, picked):\n","    ax.imshow(p.plot()[:, :, ::-1]); ax.set_title(s + ('' if s in imgs_with_defects else '  (без дефектов)'), fontsize=8)\n","    ax.axis('off')\n","for ax in list(np.atleast_1d(axes).flat)[len(preds):]:\n","    ax.axis('off')\n","plt.tight_layout(); plt.savefig(FIG_DIR / f'predictions_{RUN_NAME}.png', dpi=130); plt.show()"]},{"cell_type":"markdown","metadata":{"id":"nF6sIh3rGFMt"},"source":["## Шаг 17. Сводка по всем запускам (эпох по 100): среднее ± стандартное отклонение\n","\n","Среднее и разброс по трём запускам (seed 0, 1, 2) одной модели."]},{"cell_type":"code","execution_count":19,"metadata":{"tags":[],"colab":{"base_uri":"https://localhost:8080/","height":460},"id":"PM0yOn_lGFMt","executionInfo":{"status":"ok","timestamp":1793369097191,"user_tz":-240,"elapsed":899,"user":{"displayName":"DanilB sniu","userId":"15957076433567930351"}},"outputId":"340671b6-7c3d-4086-9619-f49d1c4260a3"},"outputs":[{"output_type":"display_data","data":{"text/plain":["                           run    model  imgsz  seed  epochs  precision  \\\n","1         yolov8n_img640_seed0  yolov8n    640     0     100     0.3992   \n","2         yolov8n_img640_seed1  yolov8n    640     1     100     0.4529   \n","3         yolov8n_img640_seed2  yolov8n    640     2     100     0.3855   \n","4  yolov8n_img640_seed0_quick2  yolov8n    640     0       3     0.1797   \n","\n","   recall      F1   mAP50  mAP50_95  inference_ms  total_ms              date  \n","1  0.3831  0.3910  0.3183    0.1529          3.87      9.74  2026-10-29 16:43  \n","2  0.3780  0.4121  0.3392    0.1622   