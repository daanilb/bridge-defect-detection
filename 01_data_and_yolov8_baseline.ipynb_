scription\": \"\"\n      }\n    },\n    {\n      \"column\": [\n        \"inference_ms\",\n        \"std\"\n      ],\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": null,\n        \"min\": 1.4052,\n        \"max\": 1.4052,\n        \"num_unique_values\": 1,\n        \"samples\": [\n          1.4052\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": [\n        \"n_runs\",\n        \"\"\n      ],\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": null,\n        \"min\": 4,\n        \"max\": 4,\n        \"num_unique_values\": 1,\n        \"samples\": [\n          4\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}}],"source":["if not (RES_DIR / 'summary.csv').exists():\n","    raise SystemExit('Пока нет результатов: сначала выполните шаги 13–14.')\n","summary = pd.read_csv(RES_DIR / 'summary.csv')\n","full = summary[~summary['run'].str.endswith('_quick')]\n","display(full) if 'display' in globals() else print(full)\n","if len(full):\n","    cols_m = ['precision', 'recall', 'F1', 'mAP50', 'mAP50_95', 'inference_ms']\n","    agg = full.groupby(['model', 'imgsz'])[cols_m].agg(['mean', 'std']).round(4)\n","    agg['n_runs'] = full.groupby(['model', 'imgsz']).size()\n","    agg.to_csv(RES_DIR / 'summary_mean_std.csv', encoding='utf-8-sig')\n","    display(agg) if 'display' in globals() else print(agg)"]},{"cell_type":"markdown","metadata":{"id":"GUgj3SfvGFMu"},"source":["## Продолжение прерванного обучения\n","\n","1. Запустить шаги 1–4 и 9–12\n","2. Вместо шага 13 запустить ячейку ниже — обучение продолжится с последней эпохи.\n","3. Затем шаги 14–17."]},{"cell_type":"code","execution_count":null,"metadata":{"tags":[],"id":"CLXXwUVEGFMu"},"outputs":[],"source":["# ПРОДОЛЖЕНИЕ ПРЕРВАННОГО ОБУЧЕНИЯ:\n","# from ultralytics import YOLO\n","# model = YOLO(str(RUNS_DIR / RUN_NAME / 'weights' / 'last.pt'))\n","# model.train(resume=True)\n","# RUN_DIR = Path(model.trainer.save_dir)\n","# BEST_WEIGHTS = RUN_DIR / 'weights' / 'best.pt'"]},{"cell_type":"markdown","metadata":{"id":"m9QuDN89GFMu"},"source":["## Результаты\n","\n","YOLOv8n, 640 px, test (239 фото), три запуска:\n","\n","| Запуск | Precision | Recall | F1 | mAP@0.5 | mAP@0.5:0.95 |\n","|---|---|---|---|---|---|\n","| seed 0 | 0.399 | 0.383 | 0.391 | 0.318 | 0.153 |\n","| seed 1 | 0.453 | 0.378 | 0.412 | 0.339 | 0.162 |\n","| seed 2 | 0.386 | 0.407 | 0.396 | 0.321 | 0.150 |\n","| **Среднее ± std** | **0.413 ± 0.036** | **0.389 ± 0.016** | **0.400 ± 0.011** | **0.326 ± 0.011** | **0.155 ± 0.006** |\n","\n","**Выводы:**\n","- Результат воспроизводим: коэффициент вариации mAP@0.5 — 3.5 %.\n","- Лучше всего находится оголённая арматура (AP@0.5 = 0.49), хуже всего — высолы (0.22) и трещины (0.18): тонкие объекты и самый редкий класс.\n","- 65 % ложных срабатываний — «трещины» на швах опалубки, стыках и тенях.\n","- Оптимальный порог уверенности различается по классам (0.22 для трещин, 0.33 для арматуры) — единый порог неоптимален.\n","\n","## Дальше\n","\n","- YOLOv8s и сравнение размера входа 640 / 1024 (тонкие трещины).\n","- **Этап 2:** классификатор фрагментов как второй каскад — отсеивает ложные срабатывания детектора; подбор порогов каскада по классам.\n"]}],"metadata":{"colab":{"provenance":[{"file_id":"19Dulthyvb_NHXKy7-LFnC2xFDxf1x7u1","timestamp":1793369161687}],"gpuType":"T4"},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"},"accelerator":"GPU"},"nbformat":4,"nbformat_minor":0}